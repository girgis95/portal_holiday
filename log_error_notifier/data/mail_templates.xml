<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- QWeb t-out escapes all log content: no HTML injection through log messages -->
    <template id="log_error_digest_email">
        <div style="font-family: Arial, Helvetica, sans-serif; font-size: 13px; color: #333;">
            <h3 style="margin: 0 0 8px 0;" t-out="title"/>
            <p style="margin: 0 0 12px 0; color: #777;">
                Database: <strong t-out="db_name"/> | Host: <strong t-out="host"/>
                <t t-if="url"> | <a t-att-href="url">All events</a></t>
            </p>
            <t t-foreach="items" t-as="item">
                <div t-attf-style="border-left: 4px solid {{ '#f0ad4e' if item['level'] == 'WARNING' else '#d9534f' }}; padding: 6px 10px; margin: 10px 0; background: #f8f8f8;">
                    <div>
                        <strong t-out="item['level']"/> x<t t-out="item['count']"/>
                        <span style="color: #777;"> - <t t-out="item['logger']"/></span>
                    </div>
                    <div style="margin: 4px 0;" t-out="item['summary']"/>
                    <div t-if="item.get('url')"><a t-att-href="item['url']">Open in Odoo</a></div>
                    <pre t-if="item.get('traceback')" style="white-space: pre-wrap; font-size: 11px; background: #fff; border: 1px solid #ddd; padding: 6px; margin: 6px 0 0 0;" t-out="item['traceback']"/>
                </div>
            </t>
        </div>
    </template>
</odoo>
